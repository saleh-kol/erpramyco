generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Contractors {
  Contractor_ID          Int                      @id @default(autoincrement())
  Company_Name           String                   @db.VarChar(150)
  Specialty              String?                  @db.VarChar(100)
  Contact_Info           String?                  @db.VarChar(250)
  Hourly_Rate            Decimal?                 @default(0.00) @db.Decimal(18, 2)
  Currency               String?                  @default("IRR") @db.VarChar(10)
  IsActive               Boolean?                 @default(true)
  KPI_Seasonal_Snapshots KPI_Seasonal_Snapshots[]
  Work_Orders            Work_Orders[]
  Work_Orders_Archive    Work_Orders_Archive[]
}

model Equipment {
  Equipment_ID          Int                         @id @default(autoincrement())
  Equipment_Code        String                      @unique(map: "Equipment_Code") @db.VarChar(50)
  ERP_Code              String?                     @db.VarChar(50)
  Equipment_Name        String                      @db.VarChar(150)
  Machine_ID            Int
  Criticality_Level     Equipment_Criticality_Level @default(Normal)
  Equipment_Price       Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Currency              String?                     @default("IRR") @db.VarChar(10)
  Purchase_Date         DateTime?                   @db.Date
  Equipment_Image_Path  String?                     @db.VarChar(500)
  Warranty_Months       Int?                        @default(0)
  IsActive              Boolean?                    @default(true)
  Machines              Machines                    @relation(fields: [Machine_ID], references: [Machine_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Equipment_Machines")
  Equipment_Spare_Parts Equipment_Spare_Parts[]
  PM_Schedules          PM_Schedules[]
  Work_Orders           Work_Orders[]
  Work_Orders_Archive   Work_Orders_Archive[]

  @@index([Equipment_Code], map: "IX_Equipment_Code")
  @@index([Machine_ID], map: "IX_Equipment_MachineID")
}

model Equipment_Spare_Parts {
  Equipment_ID      Int
  Part_ID           Int
  Quantity_Per_Unit Int         @default(1)
  Is_Standard       Boolean?    @default(true)
  Equipment         Equipment   @relation(fields: [Equipment_ID], references: [Equipment_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_EQP_Equipment")
  Spare_Parts       Spare_Parts @relation(fields: [Part_ID], references: [Part_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_EQP_SpareParts")

  @@id([Equipment_ID, Part_ID])
  @@index([Equipment_ID], map: "IX_Equipment_Parts_Equip")
  @@index([Part_ID], map: "IX_Equipment_Parts_Part")
}

model Failure_Codes {
  Failure_ID          Int                   @id @default(autoincrement())
  Failure_Code        String                @unique(map: "Failure_Code") @db.VarChar(30)
  Failure_Name        String                @db.VarChar(100)
  Work_Orders         Work_Orders[]
  Work_Orders_Archive Work_Orders_Archive[]
}

model KPI_Seasonal_Snapshots {
  Snapshot_ID   Int          @id @default(autoincrement())
  Year_No       Int
  Season_No     Int
  Machine_ID    Int?
  Contractor_ID Int?
  KPI_Name      String       @db.VarChar(50)
  KPI_Value     Decimal?     @db.Decimal(10, 2)
  Snapshot_Date DateTime?    @default(now()) @db.DateTime(0)
  Contractors   Contractors? @relation(fields: [Contractor_ID], references: [Contractor_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_KPI_Contractor")
  Machines      Machines?    @relation(fields: [Machine_ID], references: [Machine_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_KPI_Machine")

  @@index([Contractor_ID], map: "Contractor_ID")
  @@index([Machine_ID], map: "Machine_ID")
}

model Machine_Runtime_Log {
  Log_ID        Int                          @id @default(autoincrement())
  Machine_ID    Int
  Log_Date      DateTime                     @default(now()) @db.DateTime(0)
  Runtime_Hours Decimal                      @db.Decimal(18, 2)
  Log_Type      Machine_Runtime_Log_Log_Type
  Note          String?                      @db.VarChar(255)
  Machines      Machines                     @relation(fields: [Machine_ID], references: [Machine_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Runtime_Machine")

  @@index([Machine_ID, Log_Date], map: "IX_Runtime_Machine_Date")
}

model Machines {
  Machine_ID              Int                        @id @default(autoincrement())
  Machine_Code            String                     @unique(map: "Machine_Code") @db.VarChar(50)
  Machine_Name            String                     @db.VarChar(150)
  Line_ID                 Int
  Brand_Model             String?                    @db.VarChar(100)
  Specifications          String?                    @db.Text
  Installation_Date       DateTime?                  @db.Date
  Last_Maintenance_Date   DateTime?                  @db.Date
  Runtime_Hours           Decimal?                   @default(0.00) @db.Decimal(18, 2)
  Criticality_Level       Machines_Criticality_Level @default(Normal)
  Machine_Status          Machines_Machine_Status?   @default(Ready_for_work)
  IsActive                Boolean?                   @default(true)
  Equipment               Equipment[]
  KPI_Seasonal_Snapshots  KPI_Seasonal_Snapshots[]
  Machine_Runtime_Log     Machine_Runtime_Log[]
  Production_Lines        Production_Lines           @relation(fields: [Line_ID], references: [Line_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Machines_ProductionLines")
  PM_Schedules            PM_Schedules[]
  Supervisor_Machines     Supervisor_Machines[]
  TPM_Checklist_Templates TPM_Checklist_Templates[]
  Work_Orders             Work_Orders[]
  Work_Orders_Archive     Work_Orders_Archive[]

  @@index([Line_ID], map: "IX_Machines_LineID")
  @@index([Machine_Status], map: "IX_Machines_Status")
}

model Maintenance_Strategies {
  Strategy_ID         Int                   @id @default(autoincrement())
  Strategy_Code       String                @unique(map: "Strategy_Code") @db.VarChar(10)
  Strategy_Name       String                @db.VarChar(50)
  PM_Schedules        PM_Schedules[]
  Work_Orders         Work_Orders[]
  Work_Orders_Archive Work_Orders_Archive[]
}

model PM_Schedules {
  Schedule_ID            Int                    @id @default(autoincrement())
  Machine_ID             Int
  Equipment_ID           Int?
  Strategy_ID            Int                    @default(4)
  Task_Description       String                 @db.VarChar(500)
  Interval_Runtime_Hours Decimal?               @db.Decimal(10, 2)
  Interval_Days          Int?
  Last_Done_Date         DateTime?              @db.Date
  Last_Done_Runtime      Decimal?               @db.Decimal(18, 2)
  Next_Due_Date          DateTime?              @db.Date
  Next_Due_Runtime       Decimal?               @db.Decimal(18, 2)
  Estimated_Cost         Decimal?               @default(0.00) @db.Decimal(18, 2)
  IsActive               Boolean?               @default(true)
  Equipment              Equipment?             @relation(fields: [Equipment_ID], references: [Equipment_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PM_Equipment")
  Machines               Machines               @relation(fields: [Machine_ID], references: [Machine_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PM_Machine")
  Maintenance_Strategies Maintenance_Strategies @relation(fields: [Strategy_ID], references: [Strategy_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PM_Strategy")

  @@index([Equipment_ID], map: "Equipment_ID")
  @@index([Machine_ID, Next_Due_Date], map: "IX_PM_Schedule_Machine")
  @@index([Strategy_ID], map: "Strategy_ID")
}

model PR_Bonus_Types {
  Bonus_Type_ID             Int                         @id @default(autoincrement())
  Bonus_Code                String                      @unique(map: "UK_Bonus_Code") @db.VarChar(30)
  Bonus_Name                String                      @db.VarChar(100)
  Is_Fixed                  Boolean?                    @default(false)
  Default_Value             Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Description               String?                     @db.Text
  Is_Active                 Boolean?                    @default(true)
  PR_Monthly_Salary_Details PR_Monthly_Salary_Details[]
}

model PR_Commute_Logs {
  Commute_ID                                        Int                           @id @default(autoincrement())
  Personnel_ID                                      Int
  Commute_Date                                      DateTime                      @db.Date
  Commute_Type                                      PR_Commute_Logs_Commute_Type? @default(PersonalVehicle)
  Status                                            PR_Commute_Logs_Status        @default(Pending)
  Origin                                            String?                       @db.VarChar(255)
  Destination                                       String?                       @db.VarChar(255)
  Distance_KM                                       Decimal?                      @default(0.00) @db.Decimal(8, 2)
  Amount                                            Decimal?                      @default(0.00) @db.Decimal(18, 2)
  Receipt_Number                                    String?                       @db.VarChar(50)
  Description                                       String?                       @db.VarChar(255)
  Is_Approved                                       Boolean?                      @default(false)
  Approved_By                                       Int?
  Approved_At                                       DateTime?                     @db.DateTime(0)
  Created_At                                        DateTime?                     @default(now()) @db.DateTime(0)
  Manager_Score                                     Decimal?                      @db.Decimal(5, 2)
  Manager_Comment                                   String?                       @db.VarChar(500)
  Manager_ID                                        Int?
  Personnel_PR_Commute_Logs_Approved_ByToPersonnel  Personnel?                    @relation("PR_Commute_Logs_Approved_ByToPersonnel", fields: [Approved_By], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Commute_Approver")
  Personnel_PR_Commute_Logs_Personnel_IDToPersonnel Personnel                     @relation("PR_Commute_Logs_Personnel_IDToPersonnel", fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Commute_Personnel")

  @@index([Approved_By], map: "IX_PR_Commute_Approver")
  @@index([Commute_Date], map: "IX_PR_Commute_Date")
  @@index([Personnel_ID], map: "IX_PR_Commute_Personnel")
}

model PR_Daily_Reports {
  Report_ID                                          Int                              @id @default(autoincrement())
  Personnel_ID                                       Int
  Report_Date                                        DateTime                         @db.Date
  Check_In                                           DateTime?                        @db.Time(0)
  Check_Out                                          DateTime?                        @db.Time(0)
  Work_Hours                                         Decimal?                         @db.Decimal(5, 2)
  Work_Type_ID                                       Int?
  Location_ID                                        Int?
  Project_ID                                         Int?
  Work_Description                                   String?                          @db.Text
  Is_Mission                                         Boolean?                         @default(false)
  Mission_Destination                                String?                          @db.VarChar(255)
  Commute_Status                                     PR_Daily_Reports_Commute_Status? @default(None)
  Commute_Cost                                       Decimal?                         @default(0.00) @db.Decimal(18, 2)
  Report_Status                                      PR_Daily_Reports_Report_Status?  @default(Draft)
  Manager_Score                                      Decimal?                         @db.Decimal(5, 2)
  Manager_Comment                                    String?                          @db.VarChar(500)
  Manager_ID                                         Int?
  Reviewed_At                                        DateTime?                        @db.DateTime(0)
  Calculated_Daily_Amount                            Decimal?                         @default(0.00) @db.Decimal(18, 2)
  Currency                                           String?                          @default("IRR") @db.VarChar(10)
  Created_At                                         DateTime?                        @default(now()) @db.DateTime(0)
  Updated_At                                         DateTime?                        @default(now()) @db.DateTime(0)
  PR_Work_Locations                                  PR_Work_Locations?               @relation(fields: [Location_ID], references: [Location_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Report_Location")
  Personnel_PR_Daily_Reports_Manager_IDToPersonnel   Personnel?                       @relation("PR_Daily_Reports_Manager_IDToPersonnel", fields: [Manager_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Report_Manager")
  Personnel_PR_Daily_Reports_Personnel_IDToPersonnel Personnel                        @relation("PR_Daily_Reports_Personnel_IDToPersonnel", fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Report_Personnel")
  PR_Projects                                        PR_Projects?                     @relation(fields: [Project_ID], references: [Project_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Report_Project")
  PR_Work_Types                                      PR_Work_Types?                   @relation(fields: [Work_Type_ID], references: [Work_Type_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Report_WorkType")
  PR_Manager_Approvals                               PR_Manager_Approvals?

  @@index([Location_ID], map: "FK_PR_Report_Location")
  @@index([Project_ID], map: "FK_PR_Report_Project")
  @@index([Work_Type_ID], map: "FK_PR_Report_WorkType")
  @@index([Report_Date], map: "IX_PR_Report_Date")
  @@index([Manager_ID], map: "IX_PR_Report_Manager")
  @@index([Report_Status], map: "IX_PR_Report_Status")
}

model PR_Deduction_Types {
  Deduction_Type_ID         Int                         @id @default(autoincrement())
  Deduction_Code            String                      @unique(map: "UK_Deduction_Code") @db.VarChar(30)
  Deduction_Name            String                      @db.VarChar(100)
  Is_Percentage             Boolean?                    @default(false)
  Default_Value             Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Default_Percent           Decimal?                    @default(0.00) @db.Decimal(5, 2)
  Description               String?                     @db.Text
  Is_Active                 Boolean?                    @default(true)
  PR_Monthly_Salary_Details PR_Monthly_Salary_Details[]
}

model PR_Leave_Requests {
  Leave_ID                                            Int                       @id @default(autoincrement())
  Personnel_ID                                        Int
  Leave_Type_ID                                       Int
  Start_Date                                          DateTime                  @db.Date
  End_Date                                            DateTime                  @db.Date
  Days_Count                                          Int?
  Reason                                              String?                   @db.Text
  Status                                              PR_Leave_Requests_Status? @default(Pending)
  Requested_At                                        DateTime?                 @default(now()) @db.DateTime(0)
  Approved_By                                         Int?
  Approved_At                                         DateTime?                 @db.DateTime(0)
  Rejection_Reason                                    String?                   @db.VarChar(255)
  Personnel_PR_Leave_Requests_Approved_ByToPersonnel  Personnel?                @relation("PR_Leave_Requests_Approved_ByToPersonnel", fields: [Approved_By], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Leave_Approver")
  Personnel_PR_Leave_Requests_Personnel_IDToPersonnel Personnel                 @relation("PR_Leave_Requests_Personnel_IDToPersonnel", fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Leave_Personnel")
  PR_Leave_Types                                      PR_Leave_Types            @relation(fields: [Leave_Type_ID], references: [Leave_Type_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Leave_Type")

  @@index([Approved_By], map: "IX_PR_Leave_Approver")
  @@index([Personnel_ID], map: "IX_PR_Leave_Personnel")
  @@index([Status], map: "IX_PR_Leave_Status")
  @@index([Leave_Type_ID], map: "IX_PR_Leave_Type")
}

model PR_Leave_Types {
  Leave_Type_ID     Int                 @id @default(autoincrement())
  Leave_Type_Code   String              @unique(map: "UK_Leave_Type_Code") @db.VarChar(30)
  Leave_Type_Name   String              @db.VarChar(100)
  Is_Paid           Boolean?            @default(true)
  Max_Days_Per_Year Int?
  Description       String?             @db.Text
  Is_Active         Boolean?            @default(true)
  PR_Leave_Requests PR_Leave_Requests[]
}

model PR_Manager_Approvals {
  Approval_ID      Int                                   @id @default(autoincrement())
  Report_ID        Int                                   @unique(map: "UK_Approval_Report")
  Manager_ID       Int
  Approval_Score   Decimal                               @default(0.00) @db.Decimal(5, 2)
  Approval_Comment String?                               @db.VarChar(500)
  Approval_Status  PR_Manager_Approvals_Approval_Status? @default(Pending)
  Approved_At      DateTime?                             @default(now()) @db.DateTime(0)
  Personnel        Personnel                             @relation(fields: [Manager_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Approval_Manager")
  PR_Daily_Reports PR_Daily_Reports                      @relation(fields: [Report_ID], references: [Report_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Approval_Report")

  @@index([Manager_ID], map: "IX_PR_Approval_Manager")
}

model PR_Monthly_Salary {
  Salary_ID                                           Int                         @id @default(autoincrement())
  Personnel_ID                                        Int
  Salary_Year                                         Int
  Salary_Month                                        Int
  Total_Work_Hours                                    Decimal?                    @default(0.00) @db.Decimal(8, 2)
  Total_Overtime_Hours                                Decimal?                    @default(0.00) @db.Decimal(8, 2)
  Total_OffHours_Hours                                Decimal?                    @default(0.00) @db.Decimal(8, 2)
  Base_Salary                                         Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Overtime_Amount                                     Decimal?                    @default(0.00) @db.Decimal(18, 2)
  OffHours_Amount                                     Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Mission_Amount                                      Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Commute_Amount                                      Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Project_Bonus                                       Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Performance_Bonus                                   Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Gross_Salary                                        Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Total_Deductions                                    Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Net_Salary                                          Decimal?                    @default(0.00) @db.Decimal(18, 2)
  Currency                                            String?                     @default("IRR") @db.VarChar(10)
  Total_Allowances                                    Decimal?                    @default(0) @db.Decimal(18, 2)
  Insurance_Employee                                  Decimal?                    @default(0) @db.Decimal(18, 2)
  Insurance_Employer                                  Decimal?                    @default(0) @db.Decimal(18, 2)
  Tax_Amount                                          Decimal?                    @default(0) @db.Decimal(18, 2)
  Status                                              PR_Monthly_Salary_Status?   @default(Draft)
  Calculated_At                                       DateTime?                   @db.DateTime(0)
  Approved_By                                         Int?
  Approved_At                                         DateTime?                   @db.DateTime(0)
  Paid_At                                             DateTime?                   @db.DateTime(0)
  Payment_Reference                                   String?                     @db.VarChar(100)
  Created_At                                          DateTime?                   @default(now()) @db.DateTime(0)
  Updated_At                                          DateTime?                   @default(now()) @db.DateTime(0)
  Personnel_PR_Monthly_Salary_Approved_ByToPersonnel  Personnel?                  @relation("PR_Monthly_Salary_Approved_ByToPersonnel", fields: [Approved_By], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Salary_Approver")
  Personnel_PR_Monthly_Salary_Personnel_IDToPersonnel Personnel                   @relation("PR_Monthly_Salary_Personnel_IDToPersonnel", fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Salary_Personnel")
  PR_Monthly_Salary_Details                           PR_Monthly_Salary_Details[]

  @@unique([Personnel_ID, Salary_Year, Salary_Month], map: "UK_Salary_Personnel_Month")
  @@index([Approved_By], map: "IX_PR_Salary_Approver")
  @@index([Status], map: "IX_PR_Salary_Status")
}

model PR_Monthly_Salary_Details {
  Detail_ID          Int                                   @id @default(autoincrement())
  Salary_ID          Int
  Detail_Type        PR_Monthly_Salary_Details_Detail_Type
  Deduction_Type_ID  Int?
  Bonus_Type_ID      Int?
  Amount             Decimal                               @default(0.00) @db.Decimal(18, 2)
  Description        String?                               @db.VarChar(255)
  Created_At         DateTime?                             @default(now()) @db.DateTime(0)
  PR_Bonus_Types     PR_Bonus_Types?                       @relation(fields: [Bonus_Type_ID], references: [Bonus_Type_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_SalaryDetail_Bonus")
  PR_Deduction_Types PR_Deduction_Types?                   @relation(fields: [Deduction_Type_ID], references: [Deduction_Type_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_SalaryDetail_Deduction")
  PR_Monthly_Salary  PR_Monthly_Salary                     @relation(fields: [Salary_ID], references: [Salary_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_SalaryDetail_Salary")

  @@index([Bonus_Type_ID], map: "IX_PR_SalaryDetail_Bonus")
  @@index([Deduction_Type_ID], map: "IX_PR_SalaryDetail_Deduction")
  @@index([Salary_ID], map: "IX_PR_SalaryDetail_Salary")
}

model PR_Personnel_Finance {
  Finance_ID                                             Int        @id @default(autoincrement())
  Personnel_ID                                           Int
  Effective_From                                         DateTime   @db.Date
  Effective_To                                           DateTime?  @db.Date
  Base_Hourly_Rate                                       Decimal    @default(0.00) @db.Decimal(18, 2)
  Overtime_Multiplier                                    Decimal    @default(1.40) @db.Decimal(5, 2)
  OffHours_Multiplier                                    Decimal    @default(1.80) @db.Decimal(5, 2)
  Min_Weekly_Hours                                       Decimal    @default(44.00) @db.Decimal(5, 2)
  Max_Weekly_Overtime                                    Decimal    @default(20.00) @db.Decimal(5, 2)
  Holiday_Hour_Multiplier     Decimal? @default(0) @db.Decimal(5, 2)
  Friday_Hour_Multiplier      Decimal? @default(0) @db.Decimal(5, 2)
  Mission_Regular_Multiplier  Decimal? @default(0) @db.Decimal(5, 2)
  Mission_Friday_Multiplier   Decimal? @default(0) @db.Decimal(5, 2)
  Mission_Holiday_Multiplier  Decimal? @default(0) @db.Decimal(5, 2)
  Commute_Amount                                         Decimal?   @default(0.00) @db.Decimal(18, 2)
  Mission_Daily_Amount                                   Decimal?   @default(0.00) @db.Decimal(18, 2)
  Currency                                               String?    @default("IRR") @db.VarChar(10)
  Base_Monthly_Salary                                    Decimal    @default(0) @db.Decimal(18, 2)
  Housing_Allowance                                      Decimal    @default(0) @db.Decimal(18, 2)
  Food_Allowance                                         Decimal    @default(0) @db.Decimal(18, 2)
  Child_Allowance                                        Decimal    @default(0) @db.Decimal(18, 2)
  Is_Active                                              Boolean?   @default(true)
  Week1_Max_Hours         Decimal? @default(0) @db.Decimal(5, 2)
  Week1_Max_Overtime      Decimal? @default(0) @db.Decimal(5, 2)
  Week2_Max_Hours         Decimal? @default(0) @db.Decimal(5, 2)
  Week2_Max_Overtime      Decimal? @default(0) @db.Decimal(5, 2)
  Week3_Max_Hours         Decimal? @default(0) @db.Decimal(5, 2)
  Week3_Max_Overtime      Decimal? @default(0) @db.Decimal(5, 2)
  Week4_Max_Hours         Decimal? @default(0) @db.Decimal(5, 2)
  Week4_Max_Overtime      Decimal? @default(0) @db.Decimal(5, 2)
  MonthEnd_Max_Hours      Decimal? @default(0) @db.Decimal(5, 2)
  MonthEnd_Max_Overtime   Decimal? @default(0) @db.Decimal(5, 2)
  Max_Friday_Hours_Month  Decimal? @default(0) @db.Decimal(5, 2)
  Max_Holiday_Hours_Month Decimal? @default(0) @db.Decimal(5, 2)
  Created_By                                             Int?
  Created_At                                             DateTime?  @default(now()) @db.DateTime(0)
  Updated_At                                             DateTime?  @default(now()) @db.DateTime(0)
  Personnel_PR_Personnel_Finance_Created_ByToPersonnel   Personnel? @relation("PR_Personnel_Finance_Created_ByToPersonnel", fields: [Created_By], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Finance_Creator")
  Personnel_PR_Personnel_Finance_Personnel_IDToPersonnel Personnel  @relation("PR_Personnel_Finance_Personnel_IDToPersonnel", fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Finance_Personnel")

  @@unique([Personnel_ID, Effective_From], map: "UK_Personnel_Finance_Date")
  @@index([Created_By], map: "FK_PR_Finance_Creator")
  @@index([Is_Active], map: "IX_PR_Finance_Active")
  @@index([Personnel_ID], map: "IX_PR_Finance_Personnel")
}

model PR_Project_Assignments {
  Assignment_ID       Int         @id @default(autoincrement())
  Project_ID          Int
  Personnel_ID        Int
  Assigned_From       DateTime    @db.Date
  Assigned_To         DateTime?   @db.Date
  Role_In_Project     String?     @db.VarChar(100)
  Project_Hourly_Rate Decimal?    @db.Decimal(18, 2)
  Is_Active           Boolean?    @default(true)
  Created_At          DateTime?   @default(now()) @db.DateTime(0)
  Personnel           Personnel   @relation(fields: [Personnel_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Assign_Personnel")
  PR_Projects         PR_Projects @relation(fields: [Project_ID], references: [Project_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_PR_Assign_Project")

