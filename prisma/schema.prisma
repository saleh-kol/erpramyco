  Equipment                                              Equipment?             @relation(fields: [Equipment_ID], references: [Equipment_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Equipment")
  Failure_Codes                                          Failure_Codes?         @relation(fields: [Failure_ID], references: [Failure_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Failure")
  Machines                                               Machines               @relation(fields: [Machine_ID], references: [Machine_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Machine")
  Repair_Types                                           Repair_Types?          @relation(fields: [Repair_Type_ID], references: [Repair_Type_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_RepairType")
  Personnel_Work_Orders_Archive_Requester_IDToPersonnel  Personnel              @relation("Work_Orders_Archive_Requester_IDToPersonnel", fields: [Requester_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Requester")
  Maintenance_Strategies                                 Maintenance_Strategies @relation(fields: [Strategy_ID], references: [Strategy_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Strategy")
  Personnel_Work_Orders_Archive_Supervisor_IDToPersonnel Personnel              @relation("Work_Orders_Archive_Supervisor_IDToPersonnel", fields: [Supervisor_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Supervisor")
  Personnel_Work_Orders_Archive_Technician_IDToPersonnel Personnel?             @relation("Work_Orders_Archive_Technician_IDToPersonnel", fields: [Technician_ID], references: [Personnel_ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WOA_Technician")

  @@index([Contractor_ID], map: "Contractor_ID")
  @@index([Equipment_ID], map: "Equipment_ID")
  @@index([Failure_ID], map: "Failure_ID")
  @@index([Machine_ID], map: "Machine_ID")
  @@index([Repair_Type_ID], map: "Repair_Type_ID")
  @@index([Requester_ID], map: "Requester_ID")
  @@index([Status_Code], map: "Status_Code")
  @@index([Strategy_ID], map: "Strategy_ID")
  @@index([Supervisor_ID], map: "Supervisor_ID")
  @@index([Technician_ID], map: "Technician_ID")
}

